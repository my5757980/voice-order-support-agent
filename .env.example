# Voice Order Support Agent — configuration
#
# Copy to .env and fill in. The process REFUSES TO BOOT if a required value is
# missing or malformed — that is deliberate (constitution: fail fast in development,
# never paper over config errors with runtime defaults).
#
# .env is git-ignored. Never commit real keys. No key here is ever sent to the browser:
# the browser authenticates to US with a short-lived session token and never opens a
# vendor socket.
#
# Two credentials, not three. Groq serves both the language model and the speech
# synthesis, so the same key covers both slots.

# -- Required credentials ---------------------------------------------------
ASSEMBLYAI_API_KEY=
GROQ_API_KEY=

# -- Speech to text (AssemblyAI v3 streaming) -------------------------------
STT_SPEECH_MODEL=universal-3-5-pro
STT_SAMPLE_RATE=16000
STT_FRAME_MS=50
# Turn detection: AssemblyAI's documented *balanced* preset, which its docs recommend for
# "standard conversational voice agents like customer support". This project first ran the
# *aggressive* preset (160 / 400 ms, meant for IVR and yes/no confirmations); an automated
# run fed "Hi, where's my order?" through the real capture path and the comma pause alone
# committed "Hi." as a turn — the agent answered it and was interrupted by the rest of the
# sentence. Speculative dispatch starts the model during the longer trailing silence, which
# is what it is for.
STT_MIN_TURN_SILENCE_MS=400
STT_MAX_TURN_SILENCE_MS=1280
STT_END_OF_TURN_CONFIDENCE=0.4
STT_FORMAT_TURNS=true

# -- Language model ---------------------------------------------------------
# One adapter speaks Groq, Gemini and OpenAI. Switching provider is these two lines
# plus the matching <PROVIDER>_API_KEY above.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=320

# -- Text to speech (Groq / Canopy Labs Orpheus) ----------------------------
# Voices: autumn, diana, hannah, austin, daniel, troy
TTS_VOICE=hannah

# -- Barge-in ---------------------------------------------------------------
BARGE_IN_MIN_WORDS=2
BARGE_IN_GRACE_SECONDS=1.0

# -- Speculative dispatch ---------------------------------------------------
SPECULATIVE_ENABLED=true
SPECULATIVE_THRESHOLD=0.7

# -- Conversation -----------------------------------------------------------
WORKING_MEMORY_TURNS=12
HOLDING_PHRASE_DELAY_MS=400
ORDER_LOOKBACK_DAYS=90

# -- Runtime ----------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_TRANSCRIPTS=false
# Runs the entire pipeline on scripted adapters even when keys are present: no
# AssemblyAI, no model, no synthesis. Useful for rehearsing a demo without spending
# Orpheus quota (100 requests/day on the free tier, and a request is a clause).
# Leave it false anywhere a real conversation is expected — the app logs a warning
# at boot when it is on, and /api/health reports the adapters it actually chose.
DEMO_MODE=false
DATABASE_PATH=./data/orders.db
