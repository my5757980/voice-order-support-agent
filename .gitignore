# Secrets — never commit. Three vendor keys live here.
.env
.env.local
*.key

# Data
data/
*.db
*.sqlite3

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
frontend/dist/
.vite/

# Tooling
# Browser-automation artefacts. Page snapshots can capture whatever was on screen,
# so they never belong in a public repository.
.playwright-mcp/
*-secrets.md
page-*.yml
console-*.log
.DS_Store
*.log

# Generated from src/worklets/*.worklet.ts by scripts/build-worklets.mjs on every
# build and every dev start. Committing them would let a stale copy ship.
frontend/public/worklets/

# Ad-hoc screenshots taken while driving the app. Submission images live in docs/.
/ui-*.png
