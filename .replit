entrypoint = "backend/src/app.py"
modules = ["python-3.11", "nodejs-20"]

# Replit is not a preference — the lablab.ai Rule Book permits only Streamlit, Replit or
# Vercel as the demo platform, and Replit is the only one of the three that runs a
# persistent process capable of holding long-lived WebSocket servers.
run = "bash scripts/start.sh"

# Build and run are separate on purpose. The health check hits `/` shortly after `run`
# starts; with installs and the Vite build inside it, the first publish failed with
# "built successfully but failed to start". The database lives in /tmp because a
# deployment's app directory is not somewhere to count on writing — and app.py reseeds
# on boot, so every fresh container starts from the demo fixtures.
[deployment]
build = ["bash", "scripts/build.sh"]
run = ["bash", "-c", "DATABASE_PATH=/tmp/orders.db exec bash scripts/serve.sh"]
deploymentTarget = "cloudrun"

# One port, everywhere. The workspace workflow once ran the app on 5000 while this
# mapping sent the public URL to 8000, so the app was healthy on :5000 and the address
# anyone would actually open returned 502. start.sh defaults to 8000; nothing overrides it.
[[ports]]
localPort = 8000
externalPort = 80

[env]
PYTHONUNBUFFERED = "1"
PYTHONPATH = "backend"
DATABASE_PATH = "./data/orders.db"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start.sh"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "webview"
